# ChurnClinic — deploy-time configuration.
# Copy to .env (or set these in your host's env) and fill in real values.
# NEVER commit real keys to git.
# Every value has a working default in config.py — you only need to set
# what your deploy differs on (and the keys that unlock paid features).

# --- Stripe: webhook + pause-collection API calls (server-side, secret) ---
# Dashboard -> Developers -> API keys
STRIPE_API_KEY=sk_live_REPLACE_ME
# Dashboard -> Developers -> Webhooks -> your /webhooks/stripe endpoint
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- Clinic Pro checkout ($12/mo): Stripe Payment Link (public URL, not a secret) ---
# Dashboard -> Payment Links -> create "Clinic Pro" $12/mo recurring link, paste URL:
CLINIC_PRO_PAYMENT_LINK=https://buy.stripe.com/REPLACE_ME

# --- Email: Resend (free tier) ---
# https://resend.com -> API Keys
RESEND_API_KEY=re_REPLACE_ME
# Sender address. Resend ONLY delivers from addresses on a domain you
# have verified in Resend (Domains -> Add Domain). An unverified domain
# makes every send fail with 403 Forbidden. EMAIL_FROM also works as an
# alias; RESEND_FROM wins if both are set.
RESEND_FROM=ChurnClinic <noreply@yourdomain.com>

# --- App ---
# BASE_URL builds the survey/pause links inside emails.
# Default in code: https://churnclinic.onrender.com — set this to your
# own domain if you deploy elsewhere (http://localhost:8000 for dev).
BASE_URL=https://churnclinic.onrender.com
DB_PATH=/data/churnclinic.db            # persistent disk path on Render
FOUNDER_NAME=the ChurnClinic team
PRODUCT_NAME=ChurnClinic
