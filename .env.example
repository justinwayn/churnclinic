# ChurnClinic — deploy-time configuration.
# Copy to .env (or set these in your host's env) and fill in real values.
# NEVER commit real keys to git.

# --- Stripe: webhook + pause-collection API calls (server-side, secret) ---
# Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
# Dashboard -> Developers -> Webhooks -> your /webhooks/stripe endpoint
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- Clinic Pro checkout ($12/mo): Stripe Payment Link (public URL, not a secret) ---
# Dashboard -> Payment Links -> create "Clinic Pro" $12/mo recurring link, paste URL:
CLINIC_PRO_PAYMENT_LINK=https://buy.stripe.com/REPLACE_ME

# --- Email: Resend (free tier) ---
# https://resend.com -> API Keys
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM=ChurnClinic <noreply@yourdomain.com>

# --- App ---
BASE_URL=https://yourdomain.com          # used for absolute links in emails
DB_PATH=/data/churnclinic.db            # persistent disk path on Render
FOUNDER_NAME=Your Name
PRODUCT_NAME=Your SaaS
